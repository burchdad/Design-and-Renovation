# Server-only. Never put secret values in frontend scripts or public JSON.
# All gates stay disabled until docs/resend-inquiry-cutover.md is completed.
INQUIRY_RESEND_ENABLED=false
INQUIRY_SENDER_VERIFIED=false
INQUIRY_RECIPIENT_CONFIRMED=false
INQUIRY_APPROVED_TEST_PASSED=false
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=
# Notification recipient is user-approved (2026-10-13), supplied privately server-side.
# Inbox delivery is not tested; do not publish the private recipient address.
# Recipient-confirmed and activation gates stay false pending release checks.
INQUIRY_TO_EMAIL=
INQUIRY_ALLOWED_ORIGINS=https://www.designhavenbuild.com
# Approved shared rate limiter, used for HMAC counters only. Not provisioned.
INQUIRY_RATE_LIMIT_URL=
INQUIRY_RATE_LIMIT_TOKEN=
INQUIRY_RATE_LIMIT_SALT=
# Dedicated Haven-only private Blob store and project binding. Not provisioned.
INQUIRY_STORAGE_VERIFIED=false
HAVEN_INQUIRY_BLOB_STORE_ID=
HAVEN_INQUIRY_VERCEL_PROJECT_ID=
HAVEN_INQUIRY_ENVIRONMENT=
# BLOB_STORE_ID, VERCEL_PROJECT_ID and short-lived VERCEL_OIDC_TOKEN are
# supplied by the authorized Vercel connection. Do not copy tokens here.
# The adapter rejects the presence of ambient BLOB_READ_WRITE_TOKEN.
INQUIRY_RETENTION_APPROVED=false
INQUIRY_RETENTION_ENFORCED=false
INQUIRY_RETENTION_DAYS=
# VERCEL=1 is supplied by Vercel. No real-key local mode is provided.
